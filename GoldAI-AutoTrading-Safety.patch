+  if (!httpOk) return { state: 'UNKNOWN', reason: 'bridge returned non-2xx (possible mid-call failure)' };
+  if (!data || typeof data !== 'object') return { state: 'UNKNOWN', reason: 'malformed/non-JSON bridge response' };
