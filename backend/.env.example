# Server
PORT=5000
NODE_ENV=development

# Twelve Data (required for live price & historical data)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (download from Firebase Console)
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-key.json

# MetaTrader 5 — these three belong to mt5-bridge/.env (the Python bridge process
# reads them directly); they are listed here too only for convenience/reference.
MT5_SERVER=ICMarkets-Demo
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password

# Where the Express backend (routes/mt5.js) AND the 24/7 Signal Worker
# (backend/worker/) find the Python MT5 bridge. Same machine -> localhost is fine.
MT5_BRIDGE_URL=http://127.0.0.1:5001
MT5_SYMBOL=XAUUSD.

# 24/7 Signal Worker tuning (all optional — sane defaults if omitted)
WORKER_POLL_MS=20000
WORKER_CANDLE_COUNT=400
WORKER_M1_COUNT=1500


# Optional
OPENAI_API_KEY=your_openai_key_here
